# VesteIA — modelo de configuração do backend. Copie para backend/.env e ajuste.
# NUNCA coloque este arquivo com valores reais no Git, ZIP ou mensagens.

# ---- Banco legado (opcional) ------------------------------------------------
# false = inicia SEM PostgreSQL (recomendado para o provador).
# true  = carrega também catálogo, perfis e provador 2D antigos (exige requirements-legacy.txt).
DATABASE_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vesteia
DB_USER=vesteia
DB_PASSWORD=troque-esta-senha-ficticia

# Endereços do frontend autorizados a chamar a API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Provedores de imagem ---------------------------------------------------
# AVATAR_PROVIDER: photo (sem IA: exige foto de corpo inteiro) | mock (simulado) | openai | local
AVATAR_PROVIDER=photo
# TRYON_PROVIDER: mock (simulado, sem custo) | openai | catvton (local) | google-vertex
TRYON_PROVIDER=mock

# Obrigatório para CatVTON local e Google Vertex (mantido da versão 1.5.8).
TRYON_ENABLED=false
TRYON_CATVTON_URL=http://127.0.0.1:7861
TRYON_GOOGLE_PROJECT=
TRYON_GOOGLE_REGION=us-central1
TRYON_GOOGLE_MODEL=virtual-try-on-001

# ---- OpenAI Images API (créditos de API; a assinatura do ChatGPT NÃO serve) --
OPENAI_API_KEY=
# Confirmação explícita de uso pago. Sem "true", nenhuma chamada paga é feita.
AI_PAID_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high | auto  (qualidade maior = custo maior)
OPENAI_IMAGE_QUALITY=medium
# Largura x altura múltiplos de 16. Retrato 2:3:
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_TIMEOUT_SECONDS=240
# json (formato da referência atual) | multipart (formato clássico image[])
OPENAI_EDITS_TRANSPORT=json

# ---- Limites de chamadas (persistem em backend/data/usage.sqlite3) ----------
AI_DAILY_LIMIT_PAID=20
AI_TOTAL_LIMIT_PAID=100
AI_DAILY_LIMIT_LOCAL=200
AI_SESSION_LIMIT=12
AI_SESSIONS_PER_IP_DAILY=30
AI_MAX_SIZES_PER_REQUEST=4
AI_MAX_GARMENTS=4
AI_MAX_CONCURRENT=1

# ---- Sessão e uploads ---------------------------------------------------------
STUDIO_SESSION_TTL_MINUTES=60
MAX_UPLOAD_MB=8
# Opcional: exige um código para abrir sessões (útil em testes públicos).
STUDIO_ACCESS_CODE=
